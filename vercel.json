{
  "redirects": [
    {
      "source": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "www.rojasphotography.net"
        }
      ],
      "destination": "https://rojasphotography.net/$1",
      "permanent": true
    },
    {
      "source": "^/(.*)$",
      "has": [
        {
          "type": "protocol",
          "value": "http"
        }
      ],
      "destination": "https://:host/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter/sequence/process",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/keep-alive",
      "schedule": "0 12 * * *"
    }
  ]
}
